[Unit]
Description=Stafflytics Edge YOLOv11 Vision Worker
# Wait for the network, Tailscale (to reach the VPS) and MediaMTX (camera relay)
After=network-online.target tailscaled.service mediamtx.service
Wants=network-online.target

[Service]
Type=simple
User=tntinnovations
WorkingDirectory=/home/tntinnovations/projects/stafflytics-ai-private
# Use the venv's Python (system Python has no torch/ultralytics).
# --source / --server come from SERVER_URL and EDGE_CAMERA_URL in .env
ExecStart=/home/tntinnovations/projects/stafflytics-ai-private/venv/bin/python -u edge_ai_worker.py --fps 20
Environment=YOLO_CONFIG_DIR=/home/tntinnovations/.config/Ultralytics
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
