# Copy .env.example to .env and fill in real values there.
# Never commit real secrets.

GEMINI_API_KEY=your_api_key_here

# Camera source mode (the Imou Open Platform API is NOT used):
#   remote_rtsp  (default) — MediaMTX pulls from REMOTE_RTSP_URL (Tailscale peer)
#   rtsp                    — legacy local RTSP camera
export CAMERA_SOURCE_MODE=remote_rtsp

# Remote RTSP source used in remote_rtsp mode. Replace with your real stream URL.
# Leave blank to set the camera URL via the web UI (Settings -> RTSP Camera URL).
export REMOTE_RTSP_URL=rtsp://your-tailscale-peer:8554/cam

STAFFLYTICS_PORT=5002

# MySQL Database Configuration
DB_TYPE=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=stafflytics_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=stafflytics
